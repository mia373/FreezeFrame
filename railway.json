{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements-proxy.txt"
  },
  "deploy": {
    "startCommand": "python server/gemini_proxy.py",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
